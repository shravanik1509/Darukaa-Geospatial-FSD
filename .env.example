# ==============================================================================
# Darukaa.Earth Full-Stack Geospatial Platform - Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_DB=darukaa_geospatial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/darukaa_geospatial

# Backend Security & JWT
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (Vite)
# Note: In the frontend, set these in frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token_here
